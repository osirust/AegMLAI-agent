# Local H02.4 approximation only; this is not the organizer's image or ZIP.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8 HOME=/home/aegml \
    PATH=/opt/aegml/venv/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -o 1000 -g 1000 /work /home/aegml /opt/aegml/meta \
 && dpkg-query -W -f='${Package}=${Version}\n' > /opt/aegml/meta/os-packages.txt

COPY dev-lock.txt provided-requirements.txt wheels.SHA256 /opt/aegml/meta/
RUN --mount=type=bind,source=wheels,target=/wheelhouse,readonly \
    cd /wheelhouse \
 && sha256sum -c /opt/aegml/meta/wheels.SHA256 > /dev/null \
 && python3 -m venv /opt/aegml/venv \
 && /opt/aegml/venv/bin/python -m pip install --no-index --find-links=/wheelhouse -r /opt/aegml/meta/dev-lock.txt \
 && /opt/aegml/venv/bin/python -m pip check \
 && /opt/aegml/venv/bin/python -c 'import sys; assert sys.version_info[:3] == (3, 12, 3)'

WORKDIR /work
USER 1000:1000
CMD ["python3", "--version"]
