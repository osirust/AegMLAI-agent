# Скопировать значения в окружение; .env автоматически НЕ загружается.
AEGML_PROVIDER=mock
# Для API или локального сервера: AEGML_PROVIDER=chat_completions
AEGML_BASE_URL=http://localhost:11434/v1
AEGML_MODEL=replace-with-installed-model
AEGML_API_KEY=
AEGML_TIMEOUT_SECONDS=60
AEGML_MAX_TOKENS=1200
